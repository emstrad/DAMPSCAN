# Neon pooled connection string. Use the "Pooled connection" value from the Neon
# dashboard, the one whose host contains "-pooler".
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/dampscan?sslmode=require

# Where lead notifications are sent. Kept as an env var so it can be changed
# without a code deploy.
NOTIFY_EMAIL=scott@damp-survey.com

# FormSubmit AJAX endpoint for the address above.
FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/scott@damp-survey.com

# Signs the staff session cookie. Long random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Salt used when hashing visitor IP addresses. Long random string.
# Raw IPs are never stored, only sha256(ip + IP_SALT).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_SALT=

# Public origin, used in canonical and notification links.
SITE_URL=https://dampscan.co.uk
