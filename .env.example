# Neon pooled connection string. Use the "Pooled connection" value from the Neon
# dashboard, the one whose host contains "-pooler".
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/dampscan?sslmode=require

# Note: there is no FormSubmit variable here. FormSubmit sits behind Cloudflare
# and refuses server-to-server calls, so the notification is sent from the page
# and its address lives in NOTIFY_ENDPOINT in public/index.html.

# The staff dashboard access code. Typed at /staff to sign in.
# Kept here and NOT in the repository: this repo is public, and the dashboard
# behind it holds customer names, emails, phone numbers and postcodes.
# Must be at least 4 characters or every login is refused.
STAFF_ACCESS_CODE=

# Signs the staff session cookie. Long random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Salt used when hashing visitor IP addresses. Long random string.
# Raw IPs are never stored, only sha256(ip + IP_SALT).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_SALT=

# --- Google reviews (optional) ------------------------------------------
# Fills the review carousel on both sites from the real Google listings. Leave
# these blank and /api/reviews returns an empty list, which leaves whatever is
# in the page markup alone.
#
# GOOGLE_MAPS_API_KEY: a Google Maps Platform key with the Places API (New)
# enabled. Restrict it by API, not by HTTP referrer: the call is made from the
# server, so a referrer restriction would block it.
GOOGLE_MAPS_API_KEY=

# The Place ID of each Google Business Profile. Find them at
# https://developers.google.com/maps/documentation/places/web-service/place-id
# They look like ChIJN1t_tDeuEmsRUsoyG83frY4.
GOOGLE_PLACE_ID_DAMPSCAN=
GOOGLE_PLACE_ID_ATI=

# --- Address lookup (optional) ------------------------------------------
# Turns the three typed address boxes on step 3 into a "find my address"
# picker. Leave these blank and the form asks people to type the address,
# which still gets the full address onto the lead. Nothing breaks.
#
# PICK A LICENSED PROVIDER. The complete list of UK delivery points is Royal
# Mail's Postcode Address File and it is licensed. getAddress.io, the cheap
# option this project originally used, shut down on 4 February 2026 after the
# High Court found its data infringed Royal Mail's and Ideal Postcodes'
# database rights. A provider well under the licensed rate may be under it for
# the same reason.
#
# Free tiers do exist and this site's volume may fit inside one. What does not
# exist is a free unlimited source: postcodes.io is free but returns
# coordinates rather than addresses, and the OS Places API is free only for
# public sector use.
#
# ADDRESS_API_URL: the lookup URL, with {postcode} and {key} substituted in.
# Defaults to Ideal Postcodes. Nearly every provider returns PAF's own field
# names, so pointing this at a different one usually needs no code change.
ADDRESS_API_URL=https://api.ideal-postcodes.co.uk/v1/postcodes/{postcode}?api_key={key}
ADDRESS_API_KEY=

# --- Attachments (optional) ---------------------------------------------
# Lets people attach a previous survey or a photo of the problem to a booking.
# Create a Vercel Blob store and Vercel sets this automatically on deploys;
# pull it locally with `vercel env pull`.
#
# Leave it blank and /api/upload answers "not configured", the booking goes
# through as normal and the file is simply not taken. Blobs are stored private
# and are only readable through /api/admin/attachment, behind the staff login.
BLOB_READ_WRITE_TOKEN=
